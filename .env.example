# 藝術史資料庫環境變數配置範例
# 複製此文件為 .env 並填入實際的密鑰和密碼

# ==================== API 密鑰 ====================
HARVARD_API_KEY=your_harvard_api_key_here
EUROPEANA_API_KEY=your_europeana_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPL_API_KEY=your_deepl_api_key_here

# ==================== 資料庫密碼 ====================
POSTGRES_PASSWORD=arthistory_secure_pass_change_me
REDIS_PASSWORD=redis_secure_pass_change_me
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD
ES_PASSWORD=CHANGE_ME_ES_PASSWORD

# ==================== 監控服務 ====================
GRAFANA_PASSWORD=admin_change_me
PGADMIN_PASSWORD=admin_change_me

# ==================== 應用配置 ====================
LOG_LEVEL=INFO
CRAWLER_DELAY_SECONDS=0.5
CRAWLER_MAX_PAGES=10
RAG_MANAGER_PORT=8001
MONITOR_INTERVAL=3600
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ==================== 查詢翻譯（docs/designs/2026-10-09-llm-query-translation.md）====================
# llm_hinted：詞典找出已知術語當提示，再由 LLM 譯成英文檢索用查詢，生成仍用原問題；dictionary：只用詞典（舊行為）
QUERY_TRANSLATION=llm_hinted
# same：用本次請求的生成模型翻譯（本機 GPU 8 GB 放不下兩個 8B 模型，換模型會冷啟動逾時）
QUERY_TRANSLATION_MODEL=same
# /retrieve 等沒有生成模型的請求、或模型不在 rag_config.json 時改用此模型
QUERY_TRANSLATION_DEFAULT_MODEL=llama3.1:8b
# 翻譯逾時秒數；逾時或失敗即退回詞典結果，不影響回答
QUERY_TRANSLATION_TIMEOUT_SEC=3
# 翻譯模型在 Ollama 的常駐時間（Ollama 預設閒置 5 分鐘卸載）
QUERY_TRANSLATION_KEEP_ALIVE=30m
# 擴充詞典（scripts/build_term_dictionary.py 產生；不存在則只用原詞典）
QUERY_TERMS_EXTENDED=langchain-rag/art_terms_extended.json

# 查詢快取（規格 RET-11～13，決策 B10 一般鍵值快取；設計 docs/designs/2026-10-13-redis-query-cache.md）
# redis：存 Redis（重啟不失、正規化問題、來源變動失效、拒答不快取）；memory：程序內快取（舊行為）
# Redis 連不上時自動退回 memory
CACHE_BACKEND=redis
RAG_CACHE_REDIS_URL=redis://localhost:6379/0
QUERY_CACHE_TTL=3600

# 圖譜檢索（方案 A，2026-10-13 上線；設計 docs/designs/2026-10-11-graph-retrieval-anchor.md）
# anchor：畫家錨點＋Cypher 模板＋依題型退回（預設）；legacy：舊版關鍵詞模糊比對（僅回滾用）
GRAPH_RETRIEVAL=anchor
# 錨點查無時，非事實題的退回路由：fulltext（預設）／vector／hybrid（2026-10-14 實驗開關，比較中）
GRAPH_FALLBACK_NONFACT=fulltext

# 證據排除（規格 Q11，2026-10-14 老師核可；評估表 docs/designs/2026-10-14-googlebooks-shell-filter-experiment.md）
# 以 external_id 前綴排除不作為證據的來源（逗號分隔）；googlebooks_＝58 筆只有書目的空殼。空字串＝不排除
EXCLUDE_EVIDENCE_PREFIXES=googlebooks_

# ==================== 安全配置 ====================
# F-01 [MUST]：生產環境必須維持 false。設為 true 會啟用 Werkzeug 除錯器，
# 能連到 ml-service 的人即可在例外頁面執行任意 Python。僅限本機除錯時開啟。
FLASK_DEBUG=false
ENABLE_HTTPS=false
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
